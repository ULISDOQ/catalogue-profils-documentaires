{
  "schema_version": "ulisdoq-document-grammar/0.1",
  "profile_id": "ULISDOQ-PROFILE-FR-BULLETIN-DE-PAIE-CANDIDATE",
  "status": "CANDIDATE",
  "rule": "Everything below describes how a French payslip may be understood or extracted; none of it is a category invariant.",
  "semantic_concepts": [
    {
      "id": "pay_period",
      "type": "year_month_or_period",
      "presence": "EXPECTED"
    },
    {
      "id": "employer",
      "type": "organization",
      "presence": "EXPECTED"
    },
    {
      "id": "employee",
      "type": "person",
      "presence": "EXPECTED"
    },
    {
      "id": "employment_context",
      "type": "object",
      "presence": "OPTIONAL_OR_VARIABLE"
    },
    {
      "id": "remuneration_items",
      "type": "list[payroll_line]",
      "presence": "EXPECTED"
    },
    {
      "id": "employee_contributions",
      "type": "list[payroll_line]",
      "presence": "EXPECTED_OR_EMPTY"
    },
    {
      "id": "employer_contributions",
      "type": "list[payroll_line]",
      "presence": "EXPECTED_OR_EMPTY"
    },
    {
      "id": "gross_amount",
      "type": "money",
      "presence": "EXPECTED"
    },
    {
      "id": "income_tax_withholding",
      "type": "money_or_explicit_zero",
      "presence": "CONTEXTUAL"
    },
    {
      "id": "net_social_amount",
      "type": "money",
      "presence": "CONTEXTUAL"
    },
    {
      "id": "net_pay",
      "type": "money",
      "presence": "EXPECTED"
    },
    {
      "id": "monthly_cumulative_summary",
      "type": "object",
      "presence": "OPTIONAL_OR_VARIABLE"
    }
  ],
  "payroll_line_model": {
    "candidate_fields": [
      "code",
      "label",
      "quantity_or_rate",
      "base",
      "employee_credit",
      "employee_debit",
      "employer_rate",
      "employer_amount"
    ],
    "note": "Columns and labels vary by issuer/layout. Bind by semantics, not fixed coordinates or employer-specific codes."
  },
  "extraction_strategy": {
    "order": [
      "native_text_when_semantically_reliable",
      "table_or_geometry_reconstruction_when_needed",
      "targeted_render_fallback_when_text_loses_association",
      "UNKNOWN_when_binding_remains_ambiguous"
    ],
    "full_page_ocr_default": false,
    "fixed_layout_required": false,
    "employer_specific_rules_forbidden_in_parent_profile": true,
    "software_specific_rules_forbidden_in_parent_profile": true
  },
  "normalization": {
    "money": "decimal + currency when present",
    "percentages": "decimal percentage",
    "dates": "ISO-8601 when complete and unambiguous",
    "identifiers": "preserve leading zeroes",
    "empty": "EMPTY",
    "not_applicable": "NOT_APPLICABLE only with documentary evidence",
    "uncertain": "UNKNOWN"
  },
  "provenance": {
    "required_for_extracted_value": [
      "source_page",
      "source_anchor_or_region",
      "extraction_method"
    ],
    "methods": [
      "NATIVE_TEXT",
      "GEOMETRIC_TEXT",
      "RENDER_FALLBACK"
    ]
  },
  "validation_candidates": [
    "Do not confuse employee and employer contribution semantics.",
    "Do not confuse monthly and cumulative values.",
    "Do not infer a missing monetary value from neighboring values.",
    "Preserve label/value association within payroll rows.",
    "Arithmetic consistency checks are secondary evidence, not category identity."
  ],
  "variation_model": {
    "expected_to_vary": [
      "employer",
      "employee",
      "pay_period",
      "employment metadata",
      "payroll codes",
      "labels",
      "row set",
      "rates",
      "bases",
      "amounts",
      "layout",
      "software",
      "branding",
      "summary placement"
    ],
    "note": "Variation does not create a new category while the document remains a French payslip."
  }
}
