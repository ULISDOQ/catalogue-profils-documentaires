  "extraction_grammar": {
    "strategy": "NATIVE_TEXT_PLUS_TABLE_GEOMETRY_WITH_TARGETED_RENDER_FALLBACK",
    "stages": [
      {
        "stage": "DOCUMENT_IDENTITY",
        "method": "Locate document title and month/year in top header; require payroll signature anchors."
      },
      {
        "stage": "HEADER_BLOCKS",
        "method": "Extract employer from top-left block, employee identity/address from top-right block, and employment metadata from left/middle identification block."
      },
      {
        "stage": "REMUNERATION_CONTEXT",
        "method": "Read the horizontal remuneration context band immediately above the main table using column labels as anchors."
      },
      {
        "stage": "PAYROLL_TABLE",
        "method": "Segment the dominant table by header geometry; reconstruct each logical row across employee and employer columns. Preserve empty cells explicitly."
      },
      {
        "stage": "SUBTOTALS_AND_PERIODS",
        "method": "Use explicit labels such as Total brut, Total cotisations, Périodes d'activité and Net à payer avant impôt."
      },
      {
        "stage": "FOOTER_SUMMARY",
        "method": "Extract bottom summary cells by label + bounded horizontal region."
      },
      {
        "stage": "TARGETED_RENDER_FALLBACK",
        "method": "Use rendered-page region only when native text loses column association, spacing, or a label/value pair. Do not default to whole-page OCR."
      }
    ],
    "normalization": {
      "money": "decimal + EUR; comma accepted as source decimal separator",
      "percentage": "decimal percentage",
      "dates": "ISO-8601 when complete",
      "year_month": "YYYY-MM",
      "identifiers": "preserve leading zeroes",
      "empty_cell": "EMPTY",
      "not_applicable": "NOT_APPLICABLE only when documentary semantics support it",
      "unreadable": "UNKNOWN"
    },
    "provenance": {
      "required_per_field": [
        "page",
        "region_or_anchor",
        "method"
      ],
      "methods": [
        "NATIVE_TEXT",
        "GEOMETRIC_TEXT",
        "RENDER_FALLBACK"
      ]
    }
  },
